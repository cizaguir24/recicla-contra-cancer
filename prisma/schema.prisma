// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Role {
  id                String   @id @default(cuid())
  nombre            String   @unique
  esSistema         Boolean  @default(false) // protege al rol "Administrador": no se edita/borra
  puntosAcopio      Boolean  @default(false)
  fechasAcopio      Boolean  @default(false)
  sincronizarNotion Boolean  @default(false)
  configuracion     Boolean  @default(false)
  manifiestos       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  usuarios          User[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PuntoAcopio {
  id           String        @id @default(cuid())
  nombre       String
  direccion    String
  zona         String?
  materiales   String // texto libre, ej: "papel, cartón, plástico PET, aluminio"
  responsable  String?
  contacto     String?
  activo       Boolean       @default(true)
  tipoContenedor String?     // "Tipo de contenedor" de Notion, ej. "Corazón Alen", "Corazón Tlajomulco", "TapaBox"
  decisionReubicacion String? // "Decisión de Reubicación" de Notion: Sin revisar/Mantener/Dar seguimiento/Reubicar
  numeroCelular String?      // "Numero Celular" de Notion
  correoElectronico String?  // "Correo electrónico" de Notion
  estado       String?       // "Estado" de Notion (dirección)
  lat          Float?        // geocodificado desde dirección/zona/estado (OpenStreetMap Nominatim)
  lng          Float?
  geocodificadoDireccion String? // dirección exacta con la que se geocodificó, para saber si hay que repetir
  notionPageId String?       @unique // id de la página "Ubicación" en Notion, si vino de un sync
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  fechas       FechaAcopio[]
  manifiestos  Manifiesto[]
}

model FechaAcopio {
  id            String      @id @default(cuid())
  puntoAcopio   PuntoAcopio @relation(fields: [puntoAcopioId], references: [id], onDelete: Cascade)
  puntoAcopioId String
  fecha         DateTime
  horaInicio    String? // "09:00"
  horaFin       String? // "13:00"
  estado        String      @default("programada") // programada | realizada | cancelada
  notas         String?
  notionPageId  String?     @unique // id de la página en Notion "Acopios 2026", si vino de un sync
  petKg         Float?
  tapasKg       Float?
  aluminioKg    Float?
  tapasWinsKg   Float?
  totalTapas    Float? // valor de la fórmula "Total Tapas" tal cual viene de Notion
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Manifiesto {
  id                 String    @id @default(cuid())
  puntoAcopio        PuntoAcopio @relation(fields: [puntoAcopioId], references: [id])
  puntoAcopioId      String
  fechaManifiesto    DateTime
  fechaInicioPeriodo DateTime
  fechaFinPeriodo    DateTime
  titulo             String // legado: ya no se usa en UI/PDF, se conserva por manifiestos históricos
  dirigidoA          String @default("") // profesión y nombre de la persona a quien va dirigido (encabezado)
  dirigidoAPuesto    String @default("") // puesto/cargo de la persona a quien va dirigido (encabezado)
  nombreFirmante     String // nombre(s) de quien emite/firma el manifiesto (pie)
  puesto             String // puesto de quien emite/firma el manifiesto (pie)
  texto              String
  textoCierre        String @default("")
  firmaDataUrl       String? // imagen de la firma en base64 (data URL)
  pdfData            Bytes? // PDF generado, inmutable una vez creado
  totalKg            Float? // total acumulado al momento de generar el PDF
  estatus            String    @default("borrador") // borrador | generado | cancelado
  generadoAt         DateTime?
  eliminadoAt        DateTime? // borrador movido a la papelera; se purga definitivamente a los 15 días
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Fila única con la configuración general de la plantilla de Manifiestos.
model ConfiguracionManifiesto {
  id                 String   @id @default("singleton")
  textoDefault       String
  textoCierreDefault String
  updatedAt          DateTime @updatedAt
}
